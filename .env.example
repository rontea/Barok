# Copy this file to .env and replace placeholder values.
# .env is ignored by git; do not commit real API keys.

# Pollinations API key.
# Required for authenticated Pollinations requests and Pollinations-backed model calls.
# Sample: POLLINATIONS_API_KEY=<pollinations-api-key>
# Get yours at: https://enter.pollinations.ai
POLLINATIONS_API_KEY=<pollinations-api-key>

# Legacy single-account Gemini configuration (backward compatible).
GEMINI_API_KEY=

# Isolated Gemini account profiles. A task is pinned to one profile and never
# moves to another profile because of quota, rate limits, or availability.
GEMINI_ACCOUNT_A_API_KEY=
GEMINI_ACCOUNT_A_LABEL=Gemini Account A
GEMINI_ACCOUNT_A_PURPOSE=development
GEMINI_ACCOUNT_B_API_KEY=
GEMINI_ACCOUNT_B_LABEL=Gemini Account B
GEMINI_ACCOUNT_B_PURPOSE=testing
GEMINI_ACCOUNT_C_API_KEY=
GEMINI_ACCOUNT_C_LABEL=Gemini Account C
GEMINI_ACCOUNT_C_PURPOSE=separate-workspace
GEMINI_DEFAULT_PROFILE=account-a
REACT_ENGINE_PROVIDER_CONFIG=react-engine.providers.yaml
GEMINI_MAX_CONCURRENT_REQUESTS_PER_PROFILE=1
# Free execution guard: serialize each Gemini profile and keep at least six
# seconds between requests across all simultaneous runs. Set false only when
# the project has a paid tier or an externally enforced rate limit.
REACT_ENGINE_FREE_EXECUTION_PACING=true
# Local/Colab runs continue until completion evidence passes. Provider/server
# failure recovery still waits and retries from the saved checkpoint.
REACT_ENGINE_CONTINUOUS_RUN=true
# Finite safety budgets shared by automatic checkpoint continuations.
REACT_ENGINE_GLOBAL_STEP_LIMIT=1000
REACT_ENGINE_MAX_RUN_DURATION_MS=7200000
REACT_ENGINE_MAX_RECOVERY_TRANSITIONS=8
REACT_ENGINE_GEMINI_MIN_REQUEST_INTERVAL_MS=
REACT_ENGINE_GEMINI_MAX_RETRIES=3
REACT_ENGINE_LLM_MAX_REQUESTS_PER_TASK=10
GEMINI_CONTEXT_MAX_CHARACTERS=120000
GEMINI_CONTEXT_MAX_FILES_PER_REQUEST=12
GEMINI_CONTEXT_MAX_FILE_CHARACTERS=30000
GEMINI_CONTEXT_MAX_TOOL_OUTPUT_CHARACTERS=20000
GEMINI_CONTEXT_SUMMARY_TRIGGER_PERCENTAGE=75
# Optional per-model override example:
# GEMINI_MODEL_CONTEXT_MAX_CHARACTERS_GEMINI_3_5_FLASH=120000
GEMINI_RESPONSE_CACHE_TTL_MS=300000

# Optional OpenAI-compatible local fallback (for example Ollama or vLLM).
# Cross-provider fallback must also be explicitly approved for the task.
# When approved, this route is attempted before NVIDIA.
LOCAL_MODEL_ENABLED=false
LOCAL_MODEL_BASE_URL=http://127.0.0.1:11434/v1
LOCAL_MODEL_MODEL=qwen2.5-coder
# Input context window for the configured local model, in tokens.
LOCAL_MODEL_CONTEXT_WINDOW=32768
# Approximate input-token budget before the app compacts oversized local prompts.
LOCAL_MODEL_INPUT_TOKEN_LIMIT=2750

# Optional OpenAI-compatible model served from Google Colab through a tunnel.
# The API Pool UI also supports multiple Colab routes and model discovery.
COLAB_MODEL_ENABLED=false
COLAB_MODEL_TITLE=Colab model
COLAB_MODEL_BASE_URL=https://your-colab-tunnel.example/v1
# Leave blank to discover the model exposed by /v1/models.
COLAB_MODEL_MODEL=

# Gemini model choices can be selected per request or saved as Model Targets.
# Each Gemini target belongs to one explicit account profile.
# Current free Gemini text/chat target ids include:
# - gemini-3.6-flash
# - gemini-3.5-flash-lite
# - gemini-3.5-flash
# - gemini-3.1-flash-lite

# NVIDIA API key.
# Optional key for hosted NVIDIA NIM model calls.
# Sample: NVIDIA_API_KEY=nvapi-example-key
# Docs: https://docs.api.nvidia.com/
NVIDIA_API_KEY=

# NVIDIA API key pool.
# Optional comma-separated NVIDIA keys. NVIDIA_API_KEY is tried first when both are set.
# Sample: NVIDIA_API_KEYS=nvapi-primary,nvapi-worker-1,nvapi-worker-2
NVIDIA_API_KEYS=

# NVIDIA hosted NIM base URL.
# Leave as default unless targeting a different NVIDIA-compatible deployment.
# Sample: NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# OpenRouter API key and OpenAI-compatible endpoint.
# Create a key at https://openrouter.ai/settings/keys. OpenRouter credentials
# are configured here and are never entered or stored by the Settings UI.
# This application intentionally supports one OpenRouter inference key. Do not
# configure OPENROUTER_API_KEYS or rotate keys to extend free-tier limits;
# OpenRouter's free-model allowance is account-level.
OPENROUTER_API_KEY=

# Optional Tavily key. Enables the WebSearch agent/MCP tool.
# Create a key at https://app.tavily.com/
TAVILY_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Minimum spacing between OpenRouter request starts across all local runs.
# Fast pacing defaults to 3000 ms (20 requests/minute); set 0 only when the
# configured account/model limits are known to permit a higher rate.
OPENROUTER_MIN_REQUEST_INTERVAL_MS=
# Configure the OpenRouter account and all model routes in Settings > OpenRouter.
# Model targets and the structured fallback are selected and persisted in
# Settings > API Pool > OpenRouter; no OpenRouter model setting belongs in .env.

# Groq is an independent, OpenAI-compatible fallback provider. Create a key
# at https://console.groq.com/keys. The free tier is rate limited.
GROQ_ENABLED=false
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
# No model catalog is hard-coded. Configure the exact model IDs available to
# your organization. Role models fall back only to GROQ_DEFAULT_MODEL.
GROQ_DEFAULT_MODEL=
GROQ_FAST_MODEL=
GROQ_CLASSIFIER_MODEL=
GROQ_SUMMARIZER_MODEL=
GROQ_PLANNER_MODEL=
GROQ_CODER_MODEL=
GROQ_REVIEWER_MODEL=
GROQ_REPAIR_MODEL=
GROQ_REQUEST_TIMEOUT_SECONDS=90
GROQ_MAX_RETRIES=3
GROQ_RETRY_BASE_DELAY_MS=2000
GROQ_RETRY_MAX_DELAY_MS=30000
GROQ_MAX_CONCURRENCY=1
GROQ_MAX_PENDING_REQUESTS=25
GROQ_MAX_REQUESTS_PER_TASK=10
GROQ_STREAMING_ENABLED=true
GROQ_CACHE_TTL_SECONDS=300
GROQ_FALLBACK_ENABLED=false
# Comma-separated non-Groq destinations, in order. Each task must also allow
# and approve fallback. Use "local" before external providers when available.
GROQ_FALLBACK_PROVIDERS=
GROQ_FALLBACK_REQUIRES_APPROVAL=true

# Direct Cerebras OpenAI-compatible route. Agent runs pin this provider/model
# and stop for an explicit model change if Cerebras becomes unavailable.
CEREBRAS_API_KEY=
CEREBRAS_BASE_URL=https://api.cerebras.ai/v1
CEREBRAS_MODEL=gpt-oss-120b

# Direct SambaNova Cloud OpenAI-compatible route. The free signup plan starts
# with provider-issued credits; choose the model from API Pool or Model Target.
SAMBANOVA_API_KEY=
SAMBANOVA_BASE_URL=https://api.sambanova.ai/v1
SAMBANOVA_MODEL=gpt-oss-120b

# Server network boundary. Loopback is the safe default. To expose the API on
# a LAN, set SERVER_HOST=0.0.0.0, SERVER_ALLOW_LAN=true, and a high-entropy
# SERVER_API_TOKEN. Add exact browser origins to SERVER_CORS_ORIGINS only when
# the UI is hosted on a different origin.
SERVER_HOST=127.0.0.1
SERVER_ALLOW_LAN=false
SERVER_API_TOKEN=
SERVER_CORS_ORIGINS=

# Optional token for non-browser automation that changes provider settings.
# Same-origin browser requests and loopback CLI requests do not need it.
PROVIDER_SETTINGS_TOKEN=
# Exactly one Groq account/organization is supported. Rate-limit or quota
# failures never rotate to a second Groq credential.

# Kimi/Moonshot API key and OpenAI-compatible endpoint.
# Create a key at https://platform.moonshot.ai/ and keep it only in .env.
KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.ai/v1

# Requesty OpenAI-compatible gateway. Free-tier models are discovered from /models.
REQUESTY_API_KEY=
REQUESTY_BASE_URL=https://router.requesty.ai/v1
# Configure an account-supported Kimi model in API Pool after checking /v1/models.

# End-to-end limit for one LLM request across provider fallback, model/key
# rotation, retry waits, and transport cleanup (milliseconds; 5000-300000).
# Sample: REACT_ENGINE_LLM_TIMEOUT_MS=180000
REACT_ENGINE_LLM_TIMEOUT_MS=180000

# End-to-end limit for one structured planner/tool-selection request across all
# providers (milliseconds; 2000-120000). Provider attempt floors still apply:
# Gemini SDK 10000ms, NVIDIA chat 20000ms, Pollinations 8000ms. Routes that no
# longer fit are skipped so a child timeout never expands either total limit.
# Sample: REACT_ENGINE_PLANNER_TIMEOUT_MS=180000
REACT_ENGINE_PLANNER_TIMEOUT_MS=180000

# Local structured-action streaming keeps the request alive while output is
# arriving. The idle timer starts after the first SSE payload; the overall
# ceiling remains a final safety bound (milliseconds).
REACT_ENGINE_LOCAL_ACTION_IDLE_TIMEOUT_MS=10000
REACT_ENGINE_LOCAL_ACTION_OVERALL_TIMEOUT_MS=300000

# Bound provider transport attempts even when a larger request limit is configured.
# Gemini uses the profile-local retry count declared above.
REACT_ENGINE_NVIDIA_MAX_ATTEMPTS=3

# Minimum viable transport windows. Gemini is always clamped to at least the
# Google SDK's 10000ms minimum.
REACT_ENGINE_GEMINI_MIN_ATTEMPT_MS=10000
REACT_ENGINE_NVIDIA_MIN_ATTEMPT_MS=30000
# When free-tier resilience is enabled, a stalled NVIDIA model is given this
# bounded attempt window before handing off to MiniMax M3. It is clamped to
# the minimum attempt window above.
REACT_ENGINE_NVIDIA_FREE_ATTEMPT_TIMEOUT_MS=45000
# Maximum time (ms) the NVIDIA provider will wait for a throttled key to recover
# when operating under conservative/phased (free-tier) pacing profiles.
# Set to 0 to disable free-tier key waiting (revert to budget-bound behavior).
REACT_ENGINE_NVIDIA_FREE_TIER_MAX_KEY_WAIT_MS=120000
REACT_ENGINE_POLLINATIONS_MIN_ATTEMPT_MS=8000

# NVIDIA's process-wide scheduler enforces this concurrency cap independently
# for each model, while still allowing only one active request per API key.
REACT_ENGINE_NVIDIA_MAX_CONCURRENT_REQUESTS_PER_MODEL=1

# Free NVIDIA API-catalog pacing. This is per API key and applies across runs.
# Leave blank to use the six-second free-execution default; set 0 to opt out.
REACT_ENGINE_NVIDIA_MIN_REQUEST_INTERVAL_MS=

# NVIDIA 429/5xx retries without Retry-After use exponential full jitter:
# random(0, min(max, base * 2^(retry-1))). Retry-After is always honored in full.
REACT_ENGINE_NVIDIA_RETRY_BASE_MS=500
REACT_ENGINE_NVIDIA_RETRY_MAX_MS=10000

# NVIDIA model choices are selected per request/UI run, not all at once.
# You can also create custom NVIDIA Model Targets in the API Pool tab without changing code.
# Each target has a title, NVIDIA model id, and preferred NVIDIA key index.
# Current NVIDIA chat model ids include:
# - minimaxai/minimax-m3
# - z-ai/glm-5.2
# - deepseek-ai/deepseek-v4-flash
# - stepfun-ai/step-3.7-flash
# Cross-provider fallback uses minimaxai/minimax-m3 because it is expected to
# answer inside the bounded request window. GLM-5.2 remains explicitly selectable.
# - google/gemma-4-31b-it
# - google/diffusiongemma-26b-a4b-it
# - moonshotai/kimi-k2.6
# - nvidia/nemotron-3-super-120b-a12b
# - nvidia/nemotron-3-ultra-550b-a55b
# - poolside/laguna-xs-2.1
# Model targets are selected and persisted in Settings > API Pool.

# Server port for the HTTP/MCP server.
# Sample: PORT=3000
PORT=3000

# Node runtime mode.
# Use "development" locally and "production" for production builds.
# Sample: NODE_ENV=development
NODE_ENV=development

# Default folder used by the server when no workspace is provided.
# The folder is resolved relative to the project root.
# Sample: REACT_TARGET_FOLDER=target
REACT_TARGET_FOLDER=target

# Default and planner models are selected and persisted in Settings > API Pool.

# Legacy checkpoint window for bounded API/CLI callers. The web app sends
# continuousRun=true for offline targets, so this value does not end those runs.
# Valid range: 1-1000000000.
# Sample: MAX_STEPS=10
MAX_STEPS=10

# Budget value available to runtime configuration.
# Use a number; higher values allow larger runs when enforced by callers.
# Sample: BUDGET=100
BUDGET=100

# Overall request timeout in milliseconds.
# Sample: REQUEST_TIMEOUT=300000
REQUEST_TIMEOUT=300000

# Optional absolute workspace root override.
# Leave blank to use the current project directory/default runtime workspace.
# Sample: WORKSPACE_ROOT=C:\Projects\react-engine-077\target
WORKSPACE_ROOT=

# Optional comma-, semicolon-, or newline-separated registry of additional
# exact workspace roots accepted by the API. Folders approved in the workspace
# launcher are also persisted in app settings and included in the allow-list.
# Workspace selections outside the configured and approved roots are rejected.
# Sample: WORKSPACE_ALLOWED_ROOTS=C:\Projects\client-a,C:\Projects\client-b
WORKSPACE_ALLOWED_ROOTS=

# Workspace ZIP export limits (uncompressed bytes; files above the per-file
# limit are skipped). Defaults: 500 MiB total, 50,000 files, 50 MiB per file.
WORKSPACE_ZIP_MAX_BYTES=524288000
WORKSPACE_ZIP_MAX_FILES=50000
WORKSPACE_ZIP_MAX_FILE_BYTES=52428800

# Logging level.
# Valid values: debug, info, warn, error.
# Sample: LOG_LEVEL=info
LOG_LEVEL=info

# Enable extra debug behavior.
# Accepted true values include "true" and "1".
# Sample: DEBUG=false
DEBUG=false

# Enable verbose ReAct/runtime output.
# Accepted true values include "true" and "1".
# Sample: REACT_VERBOSE=false
REACT_VERBOSE=false

# Enable application logging.
# Accepted true values include "true" and "1".
# Sample: ENABLE_LOGGING=true
ENABLE_LOGGING=true

# Number of crew/sub-agents to use for crew runs.
# Valid range: 1-16.
# Sample: CREW_AGENTS=4
CREW_AGENTS=4

# Enable parallel crew execution.
# Set to "false" to force sequential crew behavior.
# Sample: CREW_PARALLEL=true
CREW_PARALLEL=true

# Enable parallel task feature flag.
# Accepted true values include "true" and "1".
# Sample: PARALLEL_TASKS=true
PARALLEL_TASKS=true

# Maximum retry attempts for retryable operations.
# Valid range: 1-10.
# Sample: MAX_RETRIES=3
MAX_RETRIES=3

# Initial retry backoff delay in milliseconds.
# Sample: RETRY_BACKOFF_MS=1000
RETRY_BACKOFF_MS=1000

# Retry backoff multiplier.
# Valid range: 1.1-5.
# Sample: RETRY_MULTIPLIER=2
RETRY_MULTIPLIER=2

# Default timeout for tool execution in milliseconds.
# Sample: TOOL_TIMEOUT_DEFAULT=30000
TOOL_TIMEOUT_DEFAULT=30000

# Bash/shell tool timeout in milliseconds.
# Sample: TOOL_TIMEOUT_BASH=30000
TOOL_TIMEOUT_BASH=30000

# File operation tool timeout in milliseconds.
# Sample: TOOL_TIMEOUT_FILEOPS=15000
TOOL_TIMEOUT_FILEOPS=15000

# Glob/search pattern tool timeout in milliseconds.
# Sample: TOOL_TIMEOUT_GLOB=10000
TOOL_TIMEOUT_GLOB=10000

# Grep/text search tool timeout in milliseconds.
# Sample: TOOL_TIMEOUT_GREP=30000
TOOL_TIMEOUT_GREP=30000

# Sub-agent tool timeout in milliseconds.
# Sample: TOOL_TIMEOUT_SUBAGENT=120000
TOOL_TIMEOUT_SUBAGENT=120000

# MCP server display/name metadata.
# Sample: MCP_SERVER_NAME=raw-react-mcp
MCP_SERVER_NAME=raw-react-mcp

# MCP server version metadata.
# Sample: MCP_VERSION=1.0.0
MCP_VERSION=1.0.0

# Optional MCP server port override.
# Leave blank to use the default server port behavior.
# Valid range when set: 1024-65535.
# Sample: MCP_PORT=3001
MCP_PORT=
