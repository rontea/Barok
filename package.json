{
  "name": "raw-react-mcp-server",
  "version": "0.0.1-experimental",
  "description": "Raw ReAct loop with Pollinations API + MCP tools standardized access",
  "main": "dist/server.js",
  "type": "module",
  "bin": {
    "raw-react-mcp": "dist/cli.js"
  },
  "workspaces": [
    "packages/core",
    "packages/engine",
    "packages/adapter-node",
    "packages/adapter-mcp",
    "apps/mcp-server",
    "examples/core-consumer"
  ],
  "scripts": {
    "build:core": "npm run build --workspace=@barok/core",
    "build:engine": "npm run build --workspace=@barok/engine",
    "build:adapter-node": "npm run build --workspace=@barok/adapter-node",
    "build:adapter-mcp": "npm run build --workspace=@barok/adapter-mcp",
    "build:mcp-server": "npm run build --workspace=@barok/mcp-server",
    "build:plugin-deepseek": "npm run build --prefix packages/plugin-deepseek",
    "build:packages": "npm run build:core && npm run build:engine && npm run build:adapter-node && npm run build:adapter-mcp && npm run build:mcp-server && npm run build:plugin-deepseek",
    "build": "npm run build:packages && tsx build.ts && vite build",
    "start": "node -e \"process.env.NODE_ENV='production'; import('./dist/server.js')\"",
    "dev": "npm run build:packages && tsx server.ts",
    "dev:port": "npm run build:packages && tsx server.ts --port",
    "start:port": "node -e \"process.env.NODE_ENV='production'; import('./dist/server.js')\" -- --port",
    "react": "node dist/cli.js react",
    "react:short": "node dist/cli.js react --max-steps 5 --budget 5",
    "crew": "node dist/cli.js crew",
    "mcp": "node dist/cli.js mcp",
    "test": "npm run test:unit",
    "smoke": "npm run test:offline",
    "test:api": "node dist/cli.js test",
    "test:offline": "node --no-warnings --import tsx tests/smoke/test-offline.js && node --no-warnings --import tsx tests/smoke/test-provider-endpoints-offline.js",
    "test:crew:offline": "node --no-warnings --import tsx tests/smoke/test-crew-offline.js",
    "test:crew:api": "node --no-warnings --import tsx tests/smoke/test-crew-api.js",
    "test:target-folder": "node --no-warnings tests/smoke/test-target-folder.js",
    "test:unit": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand --no-coverage",
    "test:unit:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch --no-coverage",
    "test:unit:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand --coverage",
    "test:operating-gates": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand --no-coverage src/evals/__tests__/operatingGates.test.ts",
    "verify:harness": "npm run typecheck && npm run test:unit && npm run test:operating-gates && npm run build && npm run test:offline && npm run test:evals:offline",
    "test:evals:offline": "node --no-warnings --import tsx scripts/run-evals.ts",
    "balance": "node dist/cli.js balance",
    "models": "node dist/cli.js models",
    "doctor": "node dist/cli.js doctor",
    "setup": "node dist/cli.js setup",
    "demo": "node dist/cli.js demo",
    "welcome": "node dist/cli.js welcome",
    "lint": "eslint src/",
    "typecheck": "npm run build:packages && tsc --noEmit --pretty false",
    "format": "prettier --write src/"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "react",
    "pollinations",
    "langgraph",
    "pydantic-ai",
    "crewai",
    "ai-agents"
  ],
  "author": "Kilo",
  "license": "MIT",
  "dependencies": {
    "@barok/core": "0.0.1-experimental",
    "@barok/engine": "0.0.1-experimental",
    "@barok/adapter-node": "0.0.1-experimental",
    "@anthropic-ai/sdk": "^0.93.0",
    "@deepseek-ai/cordis": "4.0.1",
    "@google/genai": "^2.8.0",
    "@modelcontextprotocol/sdk": "^1.25.1",
    "@tailwindcss/vite": "^4.3.0",
    "@vitejs/plugin-react": "^6.0.2",
    "archiver": "^8.0.0",
    "autoprefixer": "^10.5.0",
    "chalk": "^5.4.1",
    "commander": "^14.0.3",
    "cors": "^2.8.6",
    "dotenv": "^16.5.0",
    "express": "^5.2.1",
    "glob": "^10.3.10",
    "highlight.js": "^11.12.0",
    "lucide-react": "^1.17.0",
    "mammoth": "^1.12.0",
    "node-fetch": "^3.3.2",
    "openai": "^6.36.0",
    "pdf-parse": "^2.4.5",
    "postcss": "^8.5.15",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwindcss": "^4.3.0",
    "uuid": "^11.1.0",
    "vite": "^8.0.16",
    "winston": "^3.17.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/archiver": "^8.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.12",
    "@types/node": "^22.15.29",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.61.0",
    "@typescript-eslint/parser": "^8.61.0",
    "esbuild": "^0.28.1",
    "eslint": "^9.27.0",
    "jest": "^29.7.0",
    "playwright": "^1.61.0",
    "prettier": "^3.5.3",
    "prompts": "^2.4.2",
    "ts-jest": "^29.1.2",
    "tsx": "^4.19.44",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.61.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
